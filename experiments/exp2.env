# Эксперимент 2: 3 живых брокера, в кворуме KRaft 5 голосов (2 выведенных узла так и не удалены из кворума).
# Падение одного живого узла оставляет 2 голоса из 5 -> большинства нет -> активного контроллера нет.
# Значение переменных — как в exp1.env.
EXP_TITLE="3 brokers, quorum 3/5 (2 decommissioned voters), kill kafka1"
COMPOSE_FILES="docker-compose.yml docker-compose.exp2-quorum5.yml"
SPRING_PROFILE=exp2
TARGET=kafka1
MODE=kill
BASELINE=60
DOWN=180
RECOVERY=90
# Id брокеров, на которых должны оказаться координаторы групп (лидеры партиций __consumer_offsets)
# для consumer-1 (topic_consumer) и consumer-2 (topic_consumer_2). Id групп подбираются под них (pick-groups.py).
GROUP1_COORDINATOR=1
GROUP2_COORDINATOR=2
