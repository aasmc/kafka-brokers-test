# Эксперимент 1: 3 брокера, кворум KRaft из 3 голосов, один брокер аварийно падает.
# EXP_TITLE — описание; COMPOSE_FILES — compose-файлы стенда; SPRING_PROFILE — профиль сервиса;
# TARGET/MODE — какой контейнер и как ронять; BASELINE/DOWN/RECOVERY — длительность фаз, секунды.
EXP_TITLE="3 brokers, quorum 3/3, kill kafka1"
COMPOSE_FILES="docker-compose.yml"
SPRING_PROFILE=exp1
TARGET=kafka1
MODE=kill
BASELINE=60
DOWN=180
RECOVERY=90
# Id брокеров, на которых должны оказаться координаторы групп (лидеры партиций __consumer_offsets)
# для consumer-1 (topic_consumer) и consumer-2 (topic_consumer_2). Id групп подбираются под них (pick-groups.py).
GROUP1_COORDINATOR=1
GROUP2_COORDINATOR=2
